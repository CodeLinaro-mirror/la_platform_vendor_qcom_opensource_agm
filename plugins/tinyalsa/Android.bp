cc_library_shared {
    name: "libagm_compress_plugin",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/agm_compress_plugin.c"
    ],

    shared_libs: [
        "libsndcardparser",
        "libagmclient",
        "libutils",
        "libcutils",
        "liblog",
    ]
    + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
        true: ["libqti-tinyalsa", "libqti-tinycompress"],
        default: ["libtinyalsa", "libtinycompress"],
    })
    + select(soong_config_variable("qti", "AUDIO_FEATURE_ENABLED_DYNAMIC_LOG"), {
        true: ["libaudio_log_utils", "libexpat"],
        default: [],
    }),

    include_dirs: []
    + select(soong_config_variable("qti", "TARGET_USES_QTI_TINYCOMPRESS"), {
        true: [],
        default: ["external/tinycompress/include"],
    })
    + select(soong_config_variable("qti", "AUDIO_FEATURE_ENABLED_DYNAMIC_LOG"), {
        true: ["external/expat/lib/expat.h"],
        default: [],
    }),

    header_libs: [
        "libagm_headers",
        "libarosal_headers"
    ]
    + select(soong_config_variable("qti", "AUDIO_FEATURE_ENABLED_DYNAMIC_LOG"), {
        true: ["libaudiologutils_headers"],
        default: [],
    }),
    min_sdk_version: "34",
}

cc_library_headers {

    name: "libagmsocket_headers",
    vendor: true,
    export_include_dirs: [
        "inc",
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",

}

cc_library_shared {

    name: "libagmsocket",
    owner: "qti",
    vendor: true,

    srcs: [
        "src/agm_connection.cpp",
        ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "vendor.qti.hardware.agm-V1-ndk",
        ],

    include_dirs: [
        "vendor/qcom/opensource/agm/ipc/Socket/agm_connection/inc"
        ],

    cflags: [
        "-v",
        "-Wall",
        ],

    header_libs: [
        "libagmsocket_headers",
        "libagm_headers",
        ],

    apex_available: [
        "//apex_available:platform",
        "com.google.display_safety.har",
        "com.google.display_safety.har.update",
        "com.google.display_safety.har.stub",
    ],
    min_sdk_version: "34",

}


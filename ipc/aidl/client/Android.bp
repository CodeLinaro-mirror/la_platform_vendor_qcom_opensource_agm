cc_library_shared {
    name: "libagmclient",
    owner: "qti",
    vendor: true,

    srcs: [
        "AgmClientWrapper.cpp",
        "AgmCallback.cpp",
    ],

    cflags: [
        "-v",
        "-Wall",
        "-Wthread-safety",
    ],

    shared_libs: [
        "liblog",
        "libbase",
        "libcutils",
        "libutils",
        "vendor.qti.hardware.agm-V1-ndk",
        "libbinder_ndk",
    ],

    static_libs: [
        "libagmaidltypeconverter",
        "libaidlcommonsupport",
    ],

    header_libs: [
        "libagm_headers",
    ],

    enabled: select(soong_config_variable("qti", "AUDIO_SDV_APEX_ENABLED"), {
        "true": true,
        default: false,
    }),
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
}
